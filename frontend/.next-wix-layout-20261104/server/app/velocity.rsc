11:[["$","title","0",{"children":"Velocity Complex - Tsalla Aerospace"}],["$","meta","1",{"name":"description","content":"Tsalla Aerospace’s planned 100-acre integrated campus in Andhra Pradesh, bringing aircraft design, manufacturing and flight testing together."}],["$","meta","2",{"name":"generator","content":"Tsalla Aerospace"}],["$","meta","3",{"name":"keywords","content":"aerospace, drones, unmanned systems, AI, defense technology"}]]
