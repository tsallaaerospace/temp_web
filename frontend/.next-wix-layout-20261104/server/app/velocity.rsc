0:{"P":null,"b":"5yKgbt-5CXnjcy-8aWpFn","p":"","c":["","velocity"],"i":false,"f":[[["",{"children":["velocity",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/674fb0274f701ab3.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/532e7ff2567ea4ed.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en","className":"__variable_d8ebd1 __variable_ab7fb3","children":[["$","head",null,{"children":[["$","script",null,{"dangerouslySetInnerHTML":{"__html":"(function () {\n  var delays = [2000,4000,8000,15000,30000,60000];\n  var tries = new WeakMap();\n  document.addEventListener(\"error\", function (event) {\n    var el = event.target;\n    var tag = el && el.tagName;\n    if (tag !== \"IMG\" && tag !== \"VIDEO\" && tag !== \"SOURCE\") return;\n    var src = el.getAttribute(\"src\");\n    if (!src) return;\n    var state = tries.get(el);\n    if (!state || state.src !== src) state = { src: src, count: 0 };\n    if (state.count >= delays.length) return;\n    var wait = delays[state.count++];\n    tries.set(el, state);\n    setTimeout(function () {\n      if (!el.isConnected || el.getAttribute(\"src\") !== src) return;\n      if (tag === \"IMG\") { el.removeAttribute(\"src\"); el.setAttribute(\"src\", src); return; }\n      var video = tag === \"SOURCE\" ? el.parentElement : el;\n      if (video && typeof video.load === \"function\") video.load();\n    }, wait);\n  }, true);\n})();"}}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@300;400;500;600;700&display=swap","rel":"stylesheet"}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Anton&display=swap","rel":"stylesheet"}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Pontano+Sans:wght@300;400;500;600;700&display=swap","rel":"stylesheet"}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Orbit:wght@400;500;600;700;800;900&display=swap","rel":"stylesheet"}],["$","link",null,{"rel":"icon","href":"https://cdn.sanity.io/images/e2g21cdj/production/b713e54652cf0bd1898d61a04ac7a6dc928ea9d2-512x512.png","type":"image/svg+xml"}]]}],["$","body",null,{"className":"bg-black text-white font-orbit","suppressHydrationWarning":true,"children":["$","$L2",null,{"children":[["$","$L3",null,{}],["$","$L4",null,{}],["$","$L5",null,{}],["$","main",null,{"className":"min-h-screen","children":["$","$L6",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{"children":["$","$L8",null,{}]}],"templateStyles":[],"templateScripts":[],"notFound":[[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],[]],"forbidden":"$undefined","unauthorized":"$undefined"}]}],["$","$L9",null,{}],["$","$La",null,{}]]}]}]]}]]}],{"children":["velocity",["$","$1","c",{"children":[null,["$","$L6",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L8",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":["__PAGE__",["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-black text-white pt-[4.5rem] velocity-page font-orbit velocity_page__Q3XsM","children":[["$","section",null,{"className":"velocity_introduction__hwFLJ","aria-labelledby":"velocity-introduction","children":["$","div",null,{"className":"velocity_container__OmJZS","children":[["$","h1",null,{"id":"velocity-introduction","children":[["$","span",null,{"children":"100 acres."}],["$","br",null,{}],"From first principles to first flight."]}],["$","p",null,{"className":"velocity_lead__G1VNW","children":"Tsalla Aerospace’s planned integrated campus in Andhra Pradesh will bring aircraft design, simulation, experimentation, manufacturing, production and flight testing together—with one purpose: to put exceptional indigenous technology in the hands of those who protect us."}],["$","div",null,{"className":"velocity_introCopy__uEsjo","children":[["$","p","The strength of a defence technology company lies in its ability to turn engineering into systems that servicemen can depend on. That requires the infrastructure to build, test, learn and build again.",{"children":"The strength of a defence technology company lies in its ability to turn engineering into systems that servicemen can depend on. That requires the infrastructure to build, test, learn and build again."}],["$","p","Velocity Complex is being planned around that responsibility.",{"children":"Velocity Complex is being planned around that responsibility."}],["$","p","Envisioned across 100 acres, with land support from the Government of Andhra Pradesh, the campus will bring the full aircraft development cycle into one connected environment. Engineering teams, manufacturing facilities, integration spaces and flight-test operations will work alongside one another, supported by a planned runway and dedicated flight-testing space.",{"children":"Envisioned across 100 acres, with land support from the Government of Andhra Pradesh, the campus will bring the full aircraft development cycle into one connected environment. Engineering teams, manufacturing facilities, integration spaces and flight-test operations will work alongside one another, supported by a planned runway and dedicated flight-testing space."}],["$","p","The ambition is clear: shorten the distance between an idea, a proven aircraft and a system ready to serve.",{"children":"The ambition is clear: shorten the distance between an idea, a proven aircraft and a system ready to serve."}]]}],["$","figure",null,{"className":"velocity_campusFigure__0zSDC","children":["$","img",null,{"className":"velocity_campus__cbdiz","src":"/home/Velocity-Complex.jpg","alt":"Architectural visualisation of the planned Velocity Complex campus","loading":"lazy","decoding":"async"}]}]]}]}],[["$","section","Engineered for the complete development cycle",{"className":"velocity_section__zKatS ","aria-labelledby":"velocity-section-0","children":["$","div",null,{"className":"velocity_container__OmJZS velocity_sectionGrid__6UK6G","children":[["$","div",null,{"className":"velocity_sectionHeading__HaMNw","children":[["$","p",null,{"className":"velocity_label__IqNbv","children":["01"," / Velocity Complex"]}],["$","h2",null,{"id":"velocity-section-0","children":"Engineered for the complete development cycle"}]]}],["$","div",null,{"className":"velocity_copy__6sSq8","children":[[["$","p","At Velocity, the decisions made in design will remain connected to what happens on the production floor and in the air.",{"children":"At Velocity, the decisions made in design will remain connected to what happens on the production floor and in the air."}],["$","p","Aircraft geometry, structures, propulsion, electronics and autonomy will be developed within a shared engineering environment. Simulation will inform prototypes. Experiments will challenge assumptions. Flight-test data will return directly to the teams responsible for the next revision.",{"children":"Aircraft geometry, structures, propulsion, electronics and autonomy will be developed within a shared engineering environment. Simulation will inform prototypes. Experiments will challenge assumptions. Flight-test data will return directly to the teams responsible for the next revision."}],["$","p","A lesson discovered in flight should move quickly into a design review, a manufacturing change and the next test.",{"children":"A lesson discovered in flight should move quickly into a design review, a manufacturing change and the next test."}],["$","p","Bringing these activities together is intended to reduce the delays and coordination burdens of development across separate locations. It will also help teams address manufacturability, inspection, assembly and maintenance earlier—when those decisions can have the greatest effect on the final system.",{"children":"Bringing these activities together is intended to reduce the delays and coordination burdens of development across separate locations. It will also help teams address manufacturability, inspection, assembly and maintenance earlier—when those decisions can have the greatest effect on the final system."}]],["$","p",null,{"className":"velocity_cycle__xfRgV","children":"Design. Simulate. Build. Fly. Refine. Produce."}],null,[["$","p","One campus, organised around that continuous cycle.",{"children":"One campus, organised around that continuous cycle."}]]]}]]}]}],["$","section","Built for the next class of uncrewed aircraft",{"className":"velocity_section__zKatS ","aria-labelledby":"velocity-section-1","children":["$","div",null,{"className":"velocity_container__OmJZS velocity_sectionGrid__6UK6G","children":[["$","div",null,{"className":"velocity_sectionHeading__HaMNw","children":[["$","p",null,{"className":"velocity_label__IqNbv","children":["02"," / Velocity Complex"]}],["$","h2",null,{"id":"velocity-section-1","children":"Built for the next class of uncrewed aircraft"}]]}],["$","div",null,{"className":"velocity_copy__6sSq8","children":[[["$","p","Velocity is being conceived to support increasingly capable uncrewed systems, including the development and testing of loyal wingman-class UAVs.",{"children":"Velocity is being conceived to support increasingly capable uncrewed systems, including the development and testing of loyal wingman-class UAVs."}],["$","p","That ambition demands infrastructure beyond a prototype workshop. It requires room for aircraft assembly, systems integration, ground evaluation, flight preparation and sustained testing, alongside a path towards repeatable production.",{"children":"That ambition demands infrastructure beyond a prototype workshop. It requires room for aircraft assembly, systems integration, ground evaluation, flight preparation and sustained testing, alongside a path towards repeatable production."}],["$","p","The planned runway and flight-testing spaces are central to this vision. Their development and use will be aligned with the permissions, airspace access and safety requirements appropriate to the aircraft and programs they support.",{"children":"The planned runway and flight-testing spaces are central to this vision. Their development and use will be aligned with the permissions, airspace access and safety requirements appropriate to the aircraft and programs they support."}],["$","p","The aim is to give Tsalla the physical foundation to take on larger, more complex aircraft programs and carry them through successive stages of development.",{"children":"The aim is to give Tsalla the physical foundation to take on larger, more complex aircraft programs and carry them through successive stages of development."}]],null,null,[]]}]]}]}],["$","section","Where autonomy meets the real world",{"className":"velocity_section__zKatS ","aria-labelledby":"velocity-section-2","children":["$","div",null,{"className":"velocity_container__OmJZS velocity_sectionGrid__6UK6G","children":[["$","div",null,{"className":"velocity_sectionHeading__HaMNw","children":[["$","p",null,{"className":"velocity_label__IqNbv","children":["03"," / Velocity Complex"]}],["$","h2",null,{"id":"velocity-section-2","children":"Where autonomy meets the real world"}]]}],["$","div",null,{"className":"velocity_copy__6sSq8","children":[[["$","p","An autonomous aircraft must bring its software, sensors, onboard computing, communications and flight systems together reliably.",{"children":"An autonomous aircraft must bring its software, sensors, onboard computing, communications and flight systems together reliably."}],["$","p","Velocity is intended to provide an environment in which Tsalla can evaluate that complete system—from simulation and controlled ground experiments to integrated flight trials.",{"children":"Velocity is intended to provide an environment in which Tsalla can evaluate that complete system—from simulation and controlled ground experiments to integrated flight trials."}],["$","p","For Maverick, our AI pilot, this means a closer connection between software development and aircraft behaviour. Engineering teams will be able to examine how individual capabilities perform together, investigate discrepancies and carry those lessons into subsequent tests.",{"children":"For Maverick, our AI pilot, this means a closer connection between software development and aircraft behaviour. Engineering teams will be able to examine how individual capabilities perform together, investigate discrepancies and carry those lessons into subsequent tests."}],["$","p","The objective is to build confidence through evidence: progressively demonstrating what a system can do, understanding its limits and improving its reliability.",{"children":"The objective is to build confidence through evidence: progressively demonstrating what a system can do, understanding its limits and improving its reliability."}]],null,null,[]]}]]}]}],["$","section","Andhra Pradesh’s support. India’s capability.",{"className":"velocity_section__zKatS velocity_support__UMO0W","aria-labelledby":"velocity-section-3","children":["$","div",null,{"className":"velocity_container__OmJZS velocity_sectionGrid__6UK6G","children":[["$","div",null,{"className":"velocity_sectionHeading__HaMNw","children":[["$","p",null,{"className":"velocity_label__IqNbv","children":["04"," / Velocity Complex"]}],["$","h2",null,{"id":"velocity-section-3","children":"Andhra Pradesh’s support. India’s capability."}]]}],["$","div",null,{"className":"velocity_copy__6sSq8","children":[[["$","p","The Government of Andhra Pradesh’s support for the land provides an important foundation for the Velocity vision.",{"children":"The Government of Andhra Pradesh’s support for the land provides an important foundation for the Velocity vision."}],["$","p","Access to space for long-term aerospace development can enable a company to plan beyond its next prototype—to establish facilities, develop specialist teams and build manufacturing capacity around an enduring program of work.",{"children":"Access to space for long-term aerospace development can enable a company to plan beyond its next prototype—to establish facilities, develop specialist teams and build manufacturing capacity around an enduring program of work."}],["$","p","For Tsalla, this support creates an opportunity to bring engineering talent, industrial investment and advanced manufacturing into a shared ecosystem in Andhra Pradesh.",{"children":"For Tsalla, this support creates an opportunity to bring engineering talent, industrial investment and advanced manufacturing into a shared ecosystem in Andhra Pradesh."}]],null,["$","figure",null,{"className":"velocity_meeting__tILB1","children":[["$","img",null,{"src":"/velocity/andhra-pradesh-meeting.jpeg","alt":"Tsalla Aerospace Directors with the Minister of Infrastructure, Shri Janardhan Reddy, Government of Andhra Pradesh","width":1069,"height":720,"loading":"lazy","decoding":"async"}],["$","figcaption",null,{"children":"Tsalla Aerospace Directors with the Minister of Infrastructure, Shri Janardhan Reddy, Government of Andhra Pradesh"}]]}],[["$","p","As the campus develops, our ambition is to create opportunities for skilled engineers, technicians, manufacturing partners, suppliers and research institutions. The value should extend beyond the aircraft leaving the facility to the expertise, processes and industrial capability built around them.",{"children":"As the campus develops, our ambition is to create opportunities for skilled engineers, technicians, manufacturing partners, suppliers and research institutions. The value should extend beyond the aircraft leaving the facility to the expertise, processes and industrial capability built around them."}],["$","p","This is how infrastructure can contribute to nation building: by giving Indian talent the means to create, prove and produce technology here at home and at scale.",{"children":"This is how infrastructure can contribute to nation building: by giving Indian talent the means to create, prove and produce technology here at home and at scale."}]]]}]]}]}],["$","section","Infrastructure for long-term scale",{"className":"velocity_section__zKatS ","aria-labelledby":"velocity-section-4","children":["$","div",null,{"className":"velocity_container__OmJZS velocity_sectionGrid__6UK6G","children":[["$","div",null,{"className":"velocity_sectionHeading__HaMNw","children":[["$","p",null,{"className":"velocity_label__IqNbv","children":["05"," / Velocity Complex"]}],["$","h2",null,{"id":"velocity-section-4","children":"Infrastructure for long-term scale"}]]}],["$","div",null,{"className":"velocity_copy__6sSq8","children":[[["$","p","Velocity is intended to become a shared foundation for successive generations of Tsalla aircraft and autonomy systems.",{"children":"Velocity is intended to become a shared foundation for successive generations of Tsalla aircraft and autonomy systems."}],["$","p","Engineering facilities, manufacturing processes and testing infrastructure established for one program can strengthen the next. Teams can retain hard-won knowledge. Production methods can mature. Investment in development can contribute to capability that lasts beyond a single product.",{"children":"Engineering facilities, manufacturing processes and testing infrastructure established for one program can strengthen the next. Teams can retain hard-won knowledge. Production methods can mature. Investment in development can contribute to capability that lasts beyond a single product."}],["$","p","For partners and investors, that is the significance of the campus: a planned foundation for turning technical ambition into repeatable execution, and individual programs into an enduring aerospace enterprise.",{"children":"For partners and investors, that is the significance of the campus: a planned foundation for turning technical ambition into repeatable execution, and individual programs into an enduring aerospace enterprise."}]],null,null,[]]}]]}]}],["$","section","Built for those who serve",{"className":"velocity_section__zKatS ","aria-labelledby":"velocity-section-5","children":["$","div",null,{"className":"velocity_container__OmJZS velocity_sectionGrid__6UK6G","children":[["$","div",null,{"className":"velocity_sectionHeading__HaMNw","children":[["$","p",null,{"className":"velocity_label__IqNbv","children":["06"," / Velocity Complex"]}],["$","h2",null,{"id":"velocity-section-5","children":"Built for those who serve"}]]}],["$","div",null,{"className":"velocity_copy__6sSq8","children":[[["$","p","Every part of Velocity returns to the same purpose.",{"children":"Every part of Velocity returns to the same purpose."}],["$","p","Our servicemen deserve technology developed with a clear understanding of their responsibilities and the conditions in which they operate. Delivering it demands rigorous engineering, sustained testing and the ability to keep improving.",{"children":"Our servicemen deserve technology developed with a clear understanding of their responsibilities and the conditions in which they operate. Delivering it demands rigorous engineering, sustained testing and the ability to keep improving."}],["$","p","Velocity Complex is our commitment to building that foundation in India.",{"children":"Velocity Complex is our commitment to building that foundation in India."}]],null,null,[["$","p","100 acres dedicated to building, proving and producing the technology that will help protect those who protect us.",{"children":"100 acres dedicated to building, proving and producing the technology that will help protect those who protect us."}]]]}]]}]}]]]}],"$undefined",[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/7883fb5a59080a38.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","$Lb",null,{"children":["$Lc","$Ld",null]}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","Ugq_s3ivCKVYa7TP0FgUu",{"children":[["$","$Le",null,{"children":"$Lf"}],null]}],["$","$L10",null,{"children":"$L11"}]]}],false]],"m":"$undefined","G":["$12","$undefined"],"s":false,"S":true}
