{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build-check-bathero/types/**/*.ts",
    ".next-build-check-scroll/types/**/*.ts",
    ".next-build-check-wix-assets/types/**/*.ts",
    ".next-build-check/types/**/*.ts",
    ".next-wix-latest/types/**/*.ts",
    ".next-wix-payload-names/types/**/*.ts",
    ".next-wix-publish-2/types/**/*.ts",
    ".next-wix-release-20261027/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-wix-release-20261027-final/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
