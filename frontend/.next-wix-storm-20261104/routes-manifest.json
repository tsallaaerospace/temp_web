{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/maverick/ai-pilot",
      "destination": "/ai-pilot",
      "statusCode": 308,
      "regex": "^(?!/_next)/maverick/ai-pilot(?:/)?$"
    },
    {
      "source": "/maverick/cortex",
      "destination": "/cortex",
      "statusCode": 308,
      "regex": "^(?!/_next)/maverick/cortex(?:/)?$"
    },
    {
      "source": "/maverick/mesh",
      "destination": "/mesh",
      "statusCode": 308,
      "regex": "^(?!/_next)/maverick/mesh(?:/)?$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/careers/[slug]",
      "regex": "^/careers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/careers/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
